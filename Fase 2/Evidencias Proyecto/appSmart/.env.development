# Development env template for SmartERP
# NOTE: This file was sanitized to remove secrets committed to the repository.
# Do NOT commit secrets into the repository. Create a local file outside VCS
# (for example `.env.development.local`) with the secret values.

DJANGO_DEBUG=True
# Set your local secret key in a .env.development.local file (gitignored):
# DJANGO_SECRET_KEY=your-very-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database configuration (example keys). For dev use SQLite or set SQL Server vars
# DB_ENGINE=mssql
# DB_NAME=inventario
# DB_HOST=YOUR_DB_HOST
# DB_PORT=
# DB_USER=
# DB_PASSWORD=
# DB_DRIVER=ODBC Driver 17 for SQL Server
# DB_TRUSTED_CONNECTION=yes
# DB_TRUST_SERVER_CERTIFICATE=yes

# Use fallback to SQLite for local development
USE_SQLITE_FALLBACK=True
# To force SQLite locally, set in your local .env file:
# FORCE_SQLITE=True

# Development logging
LOG_LEVEL=DEBUG
